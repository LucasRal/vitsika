# Base URL of the FastAPI backend as seen from the BROWSER.
# Dev: the uvicorn port. Prod behind nginx: "/api" (see README-web.md).
NEXT_PUBLIC_API_URL=http://localhost:8001   # dev default lives in .env.development; copy to .env.local only to override it in dev
# Optional: absolute base URL used by server-side rendering when the public
# one is relative (e.g. "/api"). Defaults to NEXT_PUBLIC_API_URL.
# API_URL=http://127.0.0.1:8001
